Чтобы избавиться от "лесенки" и свести уровни отступа к нулю, применим паттерн "Ранний возврат" (Guard Clauses).   Pythondef process(user, action):
    if action == 'logout':
        # Логика выхода
        return True

    if action != 'login':
        return False
        
    if user is None:
        return False
        
